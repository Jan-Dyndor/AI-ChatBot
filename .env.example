# Safe, public configuration template for local FastAPI, Streamlit, and Celery
# development without Docker. Copy it to .env and replace CHANGE_ME values.
#
# Do not commit .env. It contains credentials after it has been configured.
# PostgreSQL, ChromaDB, Redis, and Ollama run on the host in this setup.

# URLs used by the Streamlit frontend when it runs directly on the host.
API_URL=http://localhost:8001/v1/chat
API_CHAT_HISTORY_URL=http://localhost:8001/v1/conversations/
API_CREATE_CONVERSATION_URL=http://localhost:8001/v1/conversations
API_LATEST_CONVERSATIONS_IDS_URL=http://localhost:8001/v1/conversations
API_TOKEN_URL=http://localhost:8001/v1/token
API_CREATE_USER=http://localhost:8001/v1/users
API_UPLOAD_FILE_URL=http://localhost:8001/v1/file
API_FILES_URL=http://localhost:8001/v1/files
API_CONVERSATIONS=http://localhost:8001/v1/conversations
# Keep the final slash. The application appends <conversation_id>/messages.
API_CONVERSATIONS_BY_ID_PART=http://localhost:8001/v1/conversations/
API_MODELS=http://localhost:8001/v1/models

# Ollama runs natively on the host and listens on port 11434 by default.
# Use any installed Ollama embedding model, but keep this name identical to the
# model downloaded with `ollama pull`.
OLLAMA_API=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma

# ChromaDB runs locally on the host.
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8000

# PostgreSQL runs locally on its default port. Use the password set by createuser.
DB_URL=postgresql://ai_chatbot:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/ai_chatbot

# Redis runs locally and is used by the Celery worker and conversation locks.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication. Generate a new, long random SECRET_KEY for every real deployment.
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
ALGORITHM=HS256
JWT_EXPIRES_TIME_MINUTES=60

# Application limits.
MAX_FILE_SIZE_BYTES=10485760

# LangSmith is optional. Leave tracing disabled unless a valid API key is supplied.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-chatbot

# Optional configuration used only by the standalone DeepEval RAG scripts.
TEST_DEEPEVALS_MODEL=llama3:8b
TEST_DEEPEVALS_TEMP=0
TEST_DEEPEVALS_TOP_K=40
TEST_DEEPEVALS_TOP_P=0.9
TEST_DEEPEVALS_NUM_CTX=4096
TEST_DEEPEVALS_NUM_PREDICT=300
TEST_DEEPEVALS_REPEAT_PENALTY=1.1
TEST_DEEPEVALS_IS_THINKING=false

# Redis Distributed Lock 
REDIS_DISTRIBUTED_LOCK_HOST=localhost
REDIS_DISTRIBUTED_LOCK_PORT=6379
REDIS_DISTRIBUTED_LOCK_DB=2
